import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import javax.swing.border.AbstractBorder;

public class PathfindingApp extends JFrame {

    public PathfindingApp() {
        this.setTitle("Đồ Án Tìm Đường - A* Visualization");
        this.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        this.setResizable(false);

        GamePanel gamePanel = new GamePanel();
        this.add(gamePanel);
        
        this.pack();
        this.setLocationRelativeTo(null);
        this.setVisible(true);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new PathfindingApp());
    }
}

// --- LỚP CHÍNH XỬ LÝ LOGIC VÀ ĐỒ HỌA ---
class GamePanel extends JPanel implements ActionListener {

    final int maxCol = 25;
    final int maxRow = 18;
    final int nodeSize = 35; 
    final int screenWidth = nodeSize * maxCol;
    final int screenHeight = nodeSize * maxRow;

    Node[][] node = new Node[maxCol][maxRow];
    Node startNode, goalNode, currentNode;
    ArrayList<Node> openList = new ArrayList<>();
    ArrayList<Node> checkedList = new ArrayList<>();
    ArrayList<Node> pathList = new ArrayList<>();

    boolean goalReached = false;
    boolean isRunning = false;
    Timer timer; 
    
    int pathIndex = -1; 
    
    final int initialSearchDelay = 10; 
    private int currentSearchDelay = initialSearchDelay;
    final int pathDelay = 50; 
    
    Node targetedNode = null; 
    
    // --- HẰNG SỐ THIẾT KẾ & DOCK ---
    final int buttonRadius = 15; 
    final int DOCK_SCALE = 15;      // Số pixel phóng to tối đa
    final int DOCK_SPEED = 10;      // Tốc độ animation (10ms)
    // ------------------------------------

    JButton btnStart, btnClearPath, btnClearWalls, btnResetAll, btnRandomMap;
    JComboBox<String> speedComboBox; 

    public GamePanel() {
        this.setPreferredSize(new Dimension(screenWidth, screenHeight + 80)); 
        this.setBackground(new Color(236, 240, 241));
        this.setLayout(null); 
        
        MouseHandler mouseHandler = new MouseHandler();
        this.addMouseListener(mouseHandler);
        this.addMouseMotionListener(mouseHandler);

        initControls();
        initGrid();
        
        timer = new Timer(currentSearchDelay, this); 
    }

    private void updateSearchDelay() {
        String selected = (String) speedComboBox.getSelectedItem();
        
        switch (selected) {
            case "Chậm (100ms)":
                currentSearchDelay = 100;
                break;
            case "Trung bình (20ms)":
                currentSearchDelay = 20;
                break;
            case "Nhanh (1ms)":
                currentSearchDelay = 1;
                break;
            case "Mặc định (10ms)":
            default:
                currentSearchDelay = 10;
                break;
        }
        if (!isRunning) {
            timer.setDelay(currentSearchDelay);
        }
    }
    
    private void initControls() {
        int yPos = screenHeight + 20;
        int btnWidth = 125; 
        int gap = 10; 
        int currentX = 10; 
        
        // --- KHỞI TẠO CÁC NÚT DÙNG GLOWBUTTON ---
        
        // 1. Bắt đầu (A*) - Xanh lá
        btnStart = new GlowButton("Bắt đầu (A*)", new Color(46, 204, 113), buttonRadius);
        btnStart.setBounds(currentX, yPos, btnWidth, 40);
        btnStart.addActionListener(e -> startSearch());
        this.add(btnStart);
        currentX += btnWidth + gap;

        // 2. Xóa đường đi - Vàng
        btnClearPath = new GlowButton("Xóa đường đi", new Color(241, 196, 15), buttonRadius);
        btnClearPath.setForeground(Color.BLACK); 
        btnClearPath.setBounds(currentX, yPos, btnWidth, 40);
        btnClearPath.addActionListener(e -> clearPath());
        this.add(btnClearPath);
        currentX += btnWidth + gap;

        // 3. Xóa tường - Xám
        btnClearWalls = new GlowButton("Xóa tường", new Color(149, 165, 166), buttonRadius); 
        btnClearWalls.setBounds(currentX, yPos, btnWidth, 40);
        btnClearWalls.addActionListener(e -> clearWalls());
        this.add(btnClearWalls);
        currentX += btnWidth + gap;

        // 4. Xóa tất cả - Đỏ
        btnResetAll = new GlowButton("Xóa tất cả", new Color(231, 76, 60), buttonRadius);
        btnResetAll.setBounds(currentX, yPos, btnWidth, 40);
        btnResetAll.addActionListener(e -> resetAll());
        this.add(btnResetAll);
        currentX += btnWidth + gap;

        // 5. Tạo tường ảo - Xanh dương
        btnRandomMap = new GlowButton("Tạo tường ảo", new Color(52, 152, 219), buttonRadius);
        btnRandomMap.setBounds(currentX, yPos, btnWidth, 40);
        btnRandomMap.addActionListener(e -> generateRandomWalls());
        this.add(btnRandomMap);
        
        // --- COMBOBOX CHỌN TỐC ĐỘ (Vị trí góc phải) ---
        int speedBoxWidth = 150;
        int speedBoxX = screenWidth - speedBoxWidth - 10;
        
        JLabel speedLabel = new JLabel("Tốc độ Animation:");
        speedLabel.setBounds(speedBoxX, yPos - 20, speedBoxWidth, 20);
        speedLabel.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 12));
        this.add(speedLabel);

        String[] speeds = {"Chậm (100ms)", "Trung bình (20ms)", "Mặc định (10ms)", "Nhanh (1ms)"};
        speedComboBox = new JComboBox<>(speeds);
        speedComboBox.setBounds(speedBoxX, yPos, speedBoxWidth, 40);
        speedComboBox.setSelectedIndex(2); 
        speedComboBox.addActionListener(e -> updateSearchDelay());
        this.add(speedComboBox);
        
        // --- GẮN DOCK ANIMATION VÀO CÁC NÚT ---
        
        JButton[] buttons = {btnStart, btnClearPath, btnClearWalls, btnResetAll, btnRandomMap};
        for (JButton btn : buttons) {
            int btnX = btn.getX();
            int btnY = btn.getY();
            int btnW = btn.getWidth();
            int btnH = btn.getHeight();

            DockAnimator animator = new DockAnimator(btn, btnX, btnY, btnW, btnH);

            btn.addMouseListener(new MouseAdapter() {
                @Override
                public void mouseEntered(MouseEvent e) {
                    animator.startAnimation(true); // Phóng to
                }

                @Override
                public void mouseExited(MouseEvent e) {
                    animator.startAnimation(false); // Thu nhỏ
                }
            });
        }
    }

    private void initGrid() {
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row] = new Node(col, row);
            }
        }
        setStartNode(4, 8);
        setGoalNode(20, 8);
    }

    private void setStartNode(int col, int row) {
        node[col][row].setAsStart();
        startNode = node[col][row];
        currentNode = startNode;
    }

    private void setGoalNode(int col, int row) {
        node[col][row].setAsGoal();
        goalNode = node[col][row];
    }

    private void clearPath() {
        goalReached = false;
        isRunning = false;
        timer.stop();
        openList.clear();
        checkedList.clear();
        pathList.clear();
        pathIndex = -1; 
        btnStart.setEnabled(true);

        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row].reset(); 
            }
        }
        setStartNode(startNode.col, startNode.row);
        setGoalNode(goalNode.col, goalNode.row);
        repaint();
    }
    
    private void clearWalls() {
        if (isRunning) return; 
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                Node n = node[col][row];
                if (n.solid && n != startNode && n != goalNode) {
                    n.setAsOpen();
                }
            }
        }
        repaint(); 
    }

    private void resetAll() {
        clearPath(); 
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                if (node[col][row] != startNode && node[col][row] != goalNode) {
                    node[col][row].setAsOpen(); 
                }
            }
        }
        setStartNode(startNode.col, startNode.row);
        setGoalNode(goalNode.col, goalNode.row);
        repaint();
    }
    
    private void startSearch() {
        if (isRunning) return;
        
        clearPath(); 
        
        isRunning = true;
        btnStart.setEnabled(false); 
        
        initAStar();
        
        timer.setDelay(currentSearchDelay);
        
        timer.start(); 
    }
    
    private void generateRandomWalls() {
        resetAll(); 
        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                if (node[col][row] == startNode || node[col][row] == goalNode) continue;
                
                node[col][row].setAsOpen();
                if (Math.random() < 0.3) {
                    node[col][row].setAsSolid();
                }
            }
        }
        repaint();
    }

    private void initAStar() {
        startNode.gCost = 0;
        startNode.hCost = getDistance(startNode, goalNode);
        startNode.calculateFCost();
        openList.add(startNode);
    }

    private void autoSearch() {
        if (openList.isEmpty()) {
            timer.stop();
            isRunning = false;
            return;
        }

        Node bestNode = openList.get(0);
        for (int i = 1; i < openList.size(); i++) {
            if (openList.get(i).fCost < bestNode.fCost) {
                bestNode = openList.get(i);
            } else if (openList.get(i).fCost == bestNode.fCost) {
                if (openList.get(i).gCost > bestNode.gCost) {
                    bestNode = openList.get(i);
                }
            }
        }
        currentNode = bestNode;

        if (currentNode == goalNode) {
            goalReached = true;
            trackThePath(); 
            return;
        }

        openList.remove(currentNode);
        checkedList.add(currentNode);
        currentNode.checked = true;

        openNode(currentNode.col, currentNode.row - 1);
        openNode(currentNode.col, currentNode.row + 1);
        openNode(currentNode.col - 1, currentNode.row);
        openNode(currentNode.col + 1, currentNode.row);
    }

    private void openNode(int col, int row) {
        if (col < 0 || col >= maxCol || row < 0 || row >= maxRow) return;
        
        Node neighbor = node[col][row];

        if (!neighbor.solid && !checkedList.contains(neighbor)) {
            int newGCost = currentNode.gCost + 1;

            if (newGCost < neighbor.gCost || !openList.contains(neighbor)) {
                neighbor.gCost = newGCost;
                neighbor.hCost = getDistance(neighbor, goalNode);
                neighbor.calculateFCost();
                neighbor.parent = currentNode;

                if (!openList.contains(neighbor)) {
                    openList.add(neighbor);
                    neighbor.open = true;
                }
            }
        }
    }

    private void trackThePath() {
        Node current = goalNode;
        while (current != startNode) {
            current = current.parent;
            if (current != startNode) {
                pathList.add(current); 
            }
        }
        
        pathIndex = pathList.size() - 1; 

        timer.stop(); 
        timer.setDelay(pathDelay); 
        timer.start();
    }
    
    private int getDistance(Node nodeA, Node nodeB) {
        int xDist = Math.abs(nodeA.col - nodeB.col);
        int yDist = Math.abs(nodeA.row - nodeB.row);
        return xDist + yDist;
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (isRunning && !goalReached) {
            autoSearch();
            repaint(); 
            
        } else if (goalReached && pathIndex >= 0) {
            Node pathNode = pathList.get(pathIndex);
            pathNode.setAsPath();
            pathIndex--; 
            repaint();
            
            if (pathIndex < 0) {
                timer.stop(); 
                isRunning = false; 
                btnStart.setEnabled(true);
            }
        } else if (isRunning && openList.isEmpty() && !goalReached) {
             timer.stop();
             isRunning = false;
             btnStart.setEnabled(true);
             repaint();
        }
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        for (int col = 0; col < maxCol; col++) {
            for (int row = 0; row < maxRow; row++) {
                node[col][row].draw(g2d, nodeSize);
            }
        }
    }

    class MouseHandler extends MouseAdapter {
        
        @Override
        public void mouseDragged(MouseEvent e) {
            handleTargetedNode(e.getX(), e.getY()); 
            drawWall(e);
        }
        
        @Override
        public void mousePressed(MouseEvent e) {
            handleTargetedNode(e.getX(), e.getY()); 
            drawWall(e);
        }
        
        @Override
        public void mouseMoved(MouseEvent e) {
            handleTargetedNode(e.getX(), e.getY());
            repaint();
        }
        
        @Override
        public void mouseExited(MouseEvent e) {
            if (targetedNode != null) {
                targetedNode.setTargeted(false);
                targetedNode = null;
                repaint();
            }
        }
        
        private void handleTargetedNode(int x, int y) {
            int col = x / nodeSize;
            int row = y / nodeSize;

            if (col >= 0 && col < maxCol && row >= 0 && row < maxRow) {
                Node newTarget = node[col][row];

                if (newTarget != targetedNode) {
                    if (targetedNode != null) {
                        targetedNode.setTargeted(false);
                    }
                    newTarget.setTargeted(true);
                    targetedNode = newTarget;
                }
            } else {
                if (targetedNode != null) {
                    targetedNode.setTargeted(false);
                    targetedNode = null;
                }
            }
        }
        
        private void drawWall(MouseEvent e) {
            if (isRunning) return;
            
            int col = e.getX() / nodeSize;
            int row = e.getY() / nodeSize;

            if (col >= 0 && col < maxCol && row >= 0 && row < maxRow) {
                Node n = node[col][row];
                
                if (n != startNode && n != goalNode) {
                    if (SwingUtilities.isLeftMouseButton(e)) {
                        n.setAsSolid();
                    } else if (SwingUtilities.isRightMouseButton(e)) {
                        n.setAsOpen();
                    }
                    repaint();
                }
            }
        }
    }
    
    // --- LỚP INNER CLASS XỬ LÝ DOCK ANIMATION NÂNG CẤP (Elastic Effect) ---
    class DockAnimator implements ActionListener {
        private JButton targetButton;
        private Timer animationTimer;
        private int originalX, originalY, originalWidth, originalHeight;
        private double currentScale = 0; // Dùng double để tính toán mượt
        private boolean growing = true;

        public DockAnimator(JButton button, int x, int y, int w, int h) {
            this.targetButton = button;
            this.originalX = x;
            this.originalY = y;
            this.originalWidth = w;
            this.originalHeight = h;

            animationTimer = new Timer(DOCK_SPEED, this);
        }

        public void startAnimation(boolean grow) {
            this.growing = grow;
            animationTimer.start();
        }
        
        public void stopAnimation() {
            animationTimer.stop();
        }

        @Override
        public void actionPerformed(ActionEvent e) {
            int targetScale = growing ? DOCK_SCALE : 0;
            
            // Tính toán độ dốc (tạo hiệu ứng chậm dần/mềm mại)
            double velocity = (targetScale - currentScale) * 0.15; // 0.15 là hệ số mượt
            
            currentScale += velocity;

            // Dừng timer khi đạt gần đích
            if ((growing && currentScale >= DOCK_SCALE - 0.5) || (!growing && currentScale <= 0.5)) {
                currentScale = growing ? DOCK_SCALE : 0;
                animationTimer.stop();
            }

            int scaleInt = (int) Math.round(currentScale);

            int newX = originalX - scaleInt / 2;
            int newY = originalY - scaleInt / 2;
            int newW = originalWidth + scaleInt;
            int newH = originalHeight + scaleInt;
            
            targetButton.setBounds(newX, newY, newW, newH);
            targetButton.getParent().repaint(); // Yêu cầu vẽ lại panel chứa nút
        }
    }
}
