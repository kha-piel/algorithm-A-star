class Node {
    int col, row;
    int gCost, hCost, fCost;
    Node parent;
    boolean start, goal, solid, open, checked, path;
    boolean isTargeted = false;
    
    public Node(int col, int row) {
        this.col = col;
        this.row = row;
    }
    
    public void setTargeted(boolean targeted) {
        this.isTargeted = targeted;
    }
    
    public void setAsStart() { start = true; goal = false; solid = false; }
    public void setAsGoal() { goal = true; start = false; solid = false; }
    public void setAsSolid() { solid = true; }
    public void setAsOpen() { open = false; checked = false; solid = false; path = false; }
    public void setAsPath() { path = true; }

    public void calculateFCost() {
        fCost = gCost + hCost;
    }
    
    public void reset() {
        open = false; checked = false; path = false;
        gCost = 0; hCost = 0; fCost = 0;
        parent = null;
        isTargeted = false;
    }

    public void draw(Graphics2D g2, int size) {
        int x = col * size;
        int y = row * size;
        int gap = 1;
        
        if (start) g2.setColor(new Color(46, 204, 113)); 
        else if (goal) g2.setColor(new Color(231, 76, 60)); 
        else if (solid) g2.setColor(new Color(44, 62, 80)); 
        else if (path) g2.setColor(new Color(241, 196, 15)); 
        else if (checked) g2.setColor(new Color(52, 152, 219)); 
        else if (open) g2.setColor(new Color(150, 250, 170)); 
        else g2.setColor(Color.WHITE); 

        g2.fillRoundRect(x + gap, y + gap, size - gap*2, size - gap*2, 10, 10);
        
        if (!solid && !start && !goal && !path && !isTargeted) {
             
             g2.setColor(new Color(220, 220, 220)); 
             
             if (checked || open) {
                 g2.setColor(new Color(180, 180, 180)); 
             }
             
             g2.drawRoundRect(x + gap, y + gap, size - gap*2, size - gap*2, 10, 10);
        }

        if (isTargeted) {
            g2.setColor(new Color(155, 89, 182)); 
            
            Stroke dashed = new BasicStroke(2, BasicStroke.CAP_BUTT, BasicStroke.JOIN_BEVEL, 0, new float[]{6}, 0);
            g2.setStroke(dashed);
            
            g2.drawRoundRect(x + gap/2, y + gap/2, size - gap, size - gap, 10, 10);
            
            g2.setStroke(new BasicStroke(1));
        }
    }
}
