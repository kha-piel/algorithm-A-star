// --- LỚP MỚI: NÚT GLOWBUTTON (Dùng Gradient cho hiệu ứng Hover/Glow) ---
class GlowButton extends JButton {
    private Color originalBg;
    private Color hoverColor;
    private int radius;
    // Lưu màu nền ban đầu (không thay đổi) để có thể reset
    private Color initialBg; 

    public GlowButton(String text, Color bg, int radius) {
        super(text);
        this.initialBg = bg;
        this.originalBg = bg;
        this.radius = radius;
        this.hoverColor = new Color(
            Math.min(255, (int) (bg.getRed() * 1.15)), 
            Math.min(255, (int) (bg.getGreen() * 1.15)), 
            Math.min(255, (int) (bg.getBlue() * 1.15))
        ); 

        setOpaque(false);
        setContentAreaFilled(false);
        setFocusPainted(false);
        setBorderPainted(false);
        setForeground(Color.WHITE);
        
        try {
            setFont(new Font("Segoe UI", Font.BOLD, 12)); 
        } catch (Exception e) {
            setFont(new Font(Font.SANS_SERIF, Font.BOLD, 12));
        }

        // Tạo viền bo tròn
        Color borderColor = new Color(originalBg.getRed(), originalBg.getGreen(), originalBg.getBlue());
        setBorder(new RoundedBorder(radius, borderColor));
        
        // Logic cho hiệu ứng Hover và Pressed
        addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                repaint();
            }

            @Override
            public void mouseExited(MouseEvent e) {
                repaint();
            }
            
            @Override
            public void mousePressed(MouseEvent e) {
                // Tùy chỉnh màu Pressed
                originalBg = new Color((int) (initialBg.getRed() * 0.8), (int) (initialBg.getGreen() * 0.8), (int) (initialBg.getBlue() * 0.8));
                repaint();
            }
            
            @Override
            public void mouseReleased(MouseEvent e) {
                 originalBg = initialBg; 
                 repaint();
            }
        });
    }

    @Override
    protected void paintComponent(Graphics g) {
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        
        int w = getWidth();
        int h = getHeight();
        
        Color baseColor = originalBg;
        Color highlightColor = originalBg;
        
        if (getModel().isRollover()) {
            // Hiệu ứng Hover: Gradient sáng
            baseColor = hoverColor;
            highlightColor = originalBg; 
        } 
        
        // Vẽ nền Gradient
        GradientPaint gp = new GradientPaint(
            0, 0, baseColor, 
            w, h, highlightColor
        );
        g2.setPaint(gp);
        g2.fillRoundRect(0, 0, w, h, radius * 2, radius * 2);

        g2.dispose();
        super.paintComponent(g); // Vẽ text lên trên
    }
}
